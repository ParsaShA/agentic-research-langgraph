# OpenAI or an OpenAI-compatible provider (e.g. a compatible gateway)
OPENAI_API_KEY=put_your_key_here
# Optional. Leave empty for the official OpenAI endpoint.
OPENAI_BASE_URL=
MODEL_NAME=gpt-4o-mini

# Required for web search
TAVILY_API_KEY=put_your_tavily_key_here

# Optional workflow settings
MAX_RESEARCH_RESULTS=5
MAX_EDITOR_REVISIONS=1
